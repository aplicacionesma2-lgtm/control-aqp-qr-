# Copia este archivo como .streamlit/secrets.toml (local) y pega los mismos
# valores en Streamlit Cloud → tu app → Settings → Secrets.
# Todos estos datos salen del JSON que descargas al crear la cuenta de
# servicio en Google Cloud Console (ver README).

SHEET_ID = "PEGA_AQUI_EL_ID_DE_TU_GOOGLE_SHEET"

[gcp_service_account]
type = "service_account"
project_id = "tu-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
client_email = "tu-cuenta@tu-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
